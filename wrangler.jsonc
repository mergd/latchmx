{
  "name": "latch",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "bmx.fldr.zip", "custom_domain": true }
  ],
  "vars": {
    "BMX_API_ORIGIN": "https://api.butterflymx.com",
    "BMX_ACCOUNTS_ORIGIN": "https://accounts.butterflymx.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/dev-session.json"]
  }
}
